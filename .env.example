# Everything here runs on free tiers. Copy to .env and fill in.

# ---- Memory layer: Hindsight (required) ----
# Option A (easiest): Hindsight Cloud. Sign up at https://ui.hindsight.vectorize.io
#   Free starter credits, plus promo code MEMHACK99 in Billing.
#   Base URL is shown in the Cloud dashboard.
# Option B (fully self-hosted, $0 forever): run the Docker image, see README.
#   Then HINDSIGHT_BASE_URL=http://localhost:8888 and leave the key empty.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

# ---- Agent LLM: any OpenAI-compatible endpoint ----
# Primary: Groq (free, no card). https://console.groq.com/keys
GROQ_API_KEY=
# Optional second free provider: Google AI Studio. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider the agent uses: groq | gemini | ollama
LLM_PROVIDER=groq
# Model override (defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.5-flash)
LLM_MODEL=

# ---- GitHub (optional, free). Lets the agent review real PRs and post comments. ----
# https://github.com/settings/tokens -> fine-grained token, Contents: read, Pull requests: read+write
GITHUB_TOKEN=
