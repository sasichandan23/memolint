# ---- Hindsight (memory layer, required) ----
# Sign up at https://ui.hindsight.vectorize.io, then create an API key.
# Base URL is shown in the Cloud dashboard. For self-hosted use http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

# ---- Agent LLM (pick one, primary is Anthropic) ----
# https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=
# https://console.groq.com/keys   (free fallback)
GROQ_API_KEY=

# Which provider the agent uses: anthropic | groq
LLM_PROVIDER=anthropic

# ---- GitHub (optional, for reviewing real PRs and posting comments) ----
# https://github.com/settings/tokens  -> fine-grained token, repo read + pull request write
GITHUB_TOKEN=
