# Every provider below is free. Copy this file to .env and fill it in.
# Memolint uses Groq first and automatically fails over to Gemini when Groq's
# daily limit is reached, so setting both is worth the two minutes.

# ---- Memory layer: Hindsight (required) ----
# Option A (easiest): Hindsight Cloud. Sign up at https://ui.hindsight.vectorize.io
#   Free starter credits, plus promo code MEMHACK99 in Billing.
#   Base URL is shown in the Cloud dashboard.
# Option B (fully self-hosted, $0 forever): run the Docker image, see README.
#   Then HINDSIGHT_BASE_URL=http://localhost:8888 and leave the key empty.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

# ---- Reviewer model: free, no card ----
# Groq. https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio. https://aistudio.google.com/apikey
# Used automatically if Groq runs out. No extra setup needed.
GEMINI_API_KEY=

# Which provider is tried first: groq | gemini | ollama | custom
LLM_PROVIDER=groq
# Model override for the primary provider only.
# Defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.5-flash
LLM_MODEL=

# ---- GitHub: review real pull requests (free) ----
# https://github.com/settings/tokens -> fine-grained token
# Permissions: Contents = read, Pull requests = read and write
GITHUB_TOKEN=

# ---- Rarely needed ----
# Set to any value to allow failing over to a local Ollama server.
# OLLAMA_API_KEY=local
# Shrink the diff budget if you keep hitting rate limits.
# MEMOLINT_MAX_DIFF_CHARS=10000
